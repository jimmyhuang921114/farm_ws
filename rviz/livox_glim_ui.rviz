Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Livox Raw PointCloud2
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Position Transformer: XYZ
      Color Transformer: Intensity
      Channel Name: intensity
      Size (Pixels): 2
      Style: Points
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Name: DECXIN Camera
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /decxin_camera/image_raw
      Normalize Range: true
    - Class: rviz_default_plugins/PointCloud2
      Name: GLIM Registered Points
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /glim_ros/points
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Size (Pixels): 2
      Style: Points
      Decay Time: 10
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: GLIM Map
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /glim_ros/map
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Size (Pixels): 2
      Style: Points
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Odometry
      Name: GLIM Mapping Odometry
      Enabled: true
      Keep: 100
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /glim_ros/odom
    - Class: rviz_default_plugins/Path
      Name: Mapping Trajectory
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /collection/trajectory
    - Class: rviz_default_plugins/MarkerArray
      Name: Approximate Visited Cells
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /coverage/markers
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1440
  Height: 900
