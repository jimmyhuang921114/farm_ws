<?xml version="1.0"?>
<package format="3">
  <name>farm_sensor_bringup</name>
  <version>0.1.0</version>

  <description>
    Sensor bringup and TF description for Livox MID-360,
    Velodyne VLP-16, FDILINK AHRS, and RealSense cameras.
  </description>

  <maintainer email="jimmy@localhost.local">jimmy</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch system -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Sensor drivers -->
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>velodyne_driver</exec_depend>
  <exec_depend>velodyne_pointcloud</exec_depend>
  <exec_depend>fdilink_ahrs</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <!-- Mapping -->
  <exec_depend>glim_ros</exec_depend>

  <!-- URDF and TF -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Collection system -->
  <exec_depend>collection_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
