 * Motor / FOC
 * ============================================================ */
#define POLE_PAIRS               7.0f
#define TWO_PI                   6.28318530718f
#define PI_F                     3.14159265359f
#define THREE_PI_2               4.71238898038f
#define SUPPLY_VOLTAGE           24.9f
#define MOTOR_VOLTAGE_LIMIT      1.5f
#define ALIGN_VOLTAGE            1.5f
/* ============================================================
 * Motion limits
 * Arduino version
 * ============================================================ */
