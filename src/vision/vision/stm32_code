    );
}
static uint16_t AS5600_ReadRawAngle(void)
{
    uint8_t data[2];
    if (
        HAL_I2C_Mem_Read(
            &hi2c1,
            AS5600_ADDR,
            AS5600_RAW_ANGLE_REG,
            I2C_MEMADD_SIZE_8BIT,
            data,
            2,
            100
        )
        != HAL_OK
    )
    {
        return 0xFFFF;
    }
    return
        (
            (
                ((uint16_t)data[0] << 8)
                | data[1]
            )
            & 0x0FFF
        );
}
/* ============================================================
 * AS5600 multi-turn angle
 * ============================================================ */
static float Sensor_UpdateAngle(void)
{
    uint16_t raw =
        AS5600_ReadRawAngle();
    if (raw == 0xFFFF)
    {
        return shaft_angle;
    }
    if (!sensor_started)
    {
        last_raw = raw;
        full_rotations = 0;
        sensor_started = 1;
    }
    else
    {
        int32_t d =
            (int32_t)raw
            - (int32_t)last_raw;
        if (d > 2048)
        {
            full_rotations--;
        }
        else if (d < -2048)
        {
            full_rotations++;
        }
        last_raw = raw;
    }
    float turns =
        (float)full_rotations
        +
        ((float)raw / 4096.0f);
    shaft_angle =
        turns * TWO_PI;
    return shaft_angle;
}
/* ============================================================
 * PWM
 * ============================================================ */
static void PWM_SetDuty(
    float da,
    float db,
    float dc
)
{
    da = constrainf_local(
        da,
        0.0f,
        1.0f
    );
    db = constrainf_local(
        db,
        0.0f,
        1.0f
    );
    dc = constrainf_local(
        dc,
        0.0f,
        1.0f
    );
    uint32_t arr =
        __HAL_TIM_GET_AUTORELOAD(
            &htim4
        ) + 1U;
    __HAL_TIM_SET_COMPARE(
        &htim4,
        TIM_CHANNEL_1,
        (uint32_t)(da * arr)
    );
    __HAL_TIM_SET_COMPARE(
        &htim4,
        TIM_CHANNEL_2,
        (uint32_t)(db * arr)
    );
    __HAL_TIM_SET_COMPARE(
        &htim4,
        TIM_CHANNEL_3,
        (uint32_t)(dc * arr)
    );
}
