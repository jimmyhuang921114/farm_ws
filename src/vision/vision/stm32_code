#define MAX_ACCELERATION         40.0f
/* ============================================================
 * Velocity PID
 * Arduino:
 *
 * P = 0.60
 * I = 0.27
 * D = 0
 * LPF = 0.16
 * ============================================================ */
#define VEL_KP                   0.60f
#define VEL_KI                   0.27f
#define VEL_KD                   0.00f
#define VEL_LPF_TF               0.16f
/* ============================================================
 * Position PID
