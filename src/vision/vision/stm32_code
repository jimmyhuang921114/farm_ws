/* ============================================================
 * Utility
 * ============================================================ */
static float constrainf_local(
    float x,
    float lo,
    float hi
)
{
    if (x < lo)
        return lo;
    if (x > hi)
        return hi;
    return x;
}
static float normalize_angle(float a)
{
    a = fmodf(a, TWO_PI);
    if (a < 0.0f)
        a += TWO_PI;
    return a;
}
